# ==============================================================================
# Environment Configuration for Streaming DWH Pipeline
# ==============================================================================

# RustFS (S3-compatible Object Storage)
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin123
RUSTFS_PORT=9002
RUSTFS_CONSOLE_PORT=9001
S3_BUCKET_NAME=bronze

# Redpanda (Kafka API Streaming Broker)
KAFKA_PORT=9092
KAFKA_TOPIC=orders_stream

# ClickHouse (Columnar DWH Engine)
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=admin123
CLICKHOUSE_DB=sales
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# Apache Superset (BI & Dashboards)
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=change-me-to-any-long-random-string-123456
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin123
